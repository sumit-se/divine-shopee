# /opt/dsindian/api.env — server-side only, never commit
# Copy this to the server before running server-init.sh:
#   scp deploy/api.env.template dsindian-prod:/opt/dsindian/api.env
# Then fill in the real values.

SPRING_PROFILES_ACTIVE=mysql

# MySQL — matches setup-db.sql credentials
DB_JDBC_URL=jdbc:mysql://localhost:3306/SALESMANAGER?autoReconnect=true&serverTimezone=UTC&useUnicode=true&characterEncoding=UTF-8
DB_USER=shopizer
DB_PASSWORD=FILL_FROM_SETUP_DB_SQL

# Cloudflare R2 — copy from env.sh
AWS_ACCESS_KEY_ID=FILL_FROM_ENV_SH
AWS_SECRET_ACCESS_KEY=FILL_FROM_ENV_SH
